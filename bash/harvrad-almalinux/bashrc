# Link dotfiles/bash to ~/.bash

export PATH=~/.node/gen/node_modules/.bin:/usr/local/neovim/bin:/usr/local/vim/bin:~/.local/bin:/home/kshu/.dotnet/tools:$PATH
. /usr/local/root/bin/thisroot.sh

alias vim=nvim

. ~/.bash/common/bashrc

if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

. "$HOME/.deno/env"

# Auto-start ssh-agent: one shared agent per user on a fixed socket.
# (The old version spawned a new agent on every login and never stopped it,
#  which left thousands of logind sessions stuck in "closing".)
if [ -z "$SSH_AUTH_SOCK" ]; then
    export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/tmp}/ssh-agent.$USER.sock"
    ssh-add -l >/dev/null 2>&1
    if [ $? -eq 2 ]; then   # 2 = no agent reachable on that socket (0/1 = agent is running)
        rm -f "$SSH_AUTH_SOCK"
        ssh-agent -a "$SSH_AUTH_SOCK" >/dev/null
    fi
fi

export PETSC_DIR=/opt/petsc
export PETSC_ARCH_DEBUG=arch-linux-c-debug
export PETSC_ARCH_OPT=arch-linux-c-opt 
export SLEPC_DIR=/opt/slepc


# Added by Antigravity CLI installer
export PATH="/home/kshu/.local/bin:$PATH"
